# Copy to .env and fill in. Never commit real values.

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/plate"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""
# Optional Google sign-in (enabled only when both are set)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Food data providers (all optional; local database works without them)
USDA_API_KEY=""
OPEN_FOOD_FACTS_URL="https://world.openfoodfacts.org"
# Optional extra nutrition API
NUTRITION_API_KEY=""
# Optional official web search API used only to show links (never to extract numbers)
SEARCH_API_KEY=""
SEARCH_API_URL=""
